# Copy to infra/.env (never committed) and fill in. Every variable is explained in docs/runbooks/deploy.md.

# Public address: Caddy serves this host name, QR codes on documents point to PUBLIC_URL
SITE_ADDRESS=zeka.aztu.edu.az
PUBLIC_URL=https://zeka.aztu.edu.az

# Run mode and the proxy in front of the app (Caddy = 1 hop)
ZEKA_MODE=prod
ZEKA_PROXY_HOPS=1
ZEKA_TZ=Asia/Baku
ZEKA_WORKERS=2

# Backups (docs/runbooks/backup.md): second host in the country and the key mounted as a compose secret
BACKUP_REMOTE=zeka-backup@backup.aztu.edu.az:/srv/zeka-backups
BACKUP_KEY_FILE=/run/secrets/backup_key

# Optional: a real LLM instead of the offline engine (otherwise leave empty)
AZTU_LLM_PROVIDER=
AZTU_LLM_BASE_URL=
AZTU_LLM_API_KEY=
AZTU_LLM_MODEL=
# the service's organisation and the country it processes in: the privacy notice names them; a change asks the consent again
AZTU_LLM_VENDOR=
AZTU_LLM_COUNTRY=

# Optional: e-mail notifications (Task 36). Without ZEKA_SMTP_HOST nothing is e-mailed.
ZEKA_SMTP_HOST=
ZEKA_SMTP_PORT=587
ZEKA_SMTP_TLS=starttls
ZEKA_SMTP_USER=
ZEKA_SMTP_PASSWORD=
ZEKA_SMTP_FROM=

# Vulnerability reports (Task 41): served at /.well-known/security.txt; a mailto: or https: address. Empty: no file.
ZEKA_SECURITY_CONTACT=
# the date the contact is reviewed by (YYYY-MM-DD, at most a year ahead): security.txt's Expires; past or empty: no file
ZEKA_SECURITY_EXPIRES=
